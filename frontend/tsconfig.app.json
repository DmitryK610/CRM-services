{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "src/**/*",
    "src/**/*.vue",
    "!src/components/ui/AppDatePicker.vue",
    "!src/components/ui/AppSpinner.vue"
  ],
  "exclude": [
    "src/**/__tests__/*",
    "src/components/ui/AppDatePicker.vue",
    "src/components/ui/AppSpinner.vue"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
